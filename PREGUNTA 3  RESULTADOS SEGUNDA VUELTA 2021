      "cell_type": "markdown",
      "source": [
        "##4. Cálculo del ratio Keiko / Castillo por provincia\n",
        "Pivotamos la tabla para tener una fila por provincia\n",
        "y calculamos el ratio de votos."
      ],
      "metadata": {
        "id": "5fH9QdYHNeKY"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Instalamos tidyr para hacer el pivot\n",
        "install.packages(\"tidyr\")\n",
        "library(tidyr)\n",
        "library(dplyr)\n",
        "\n",
        "# Pivotamos: una fila por provincia, columnas por candidato\n",
        "df_wide <- df_candidatos %>%\n",
        "  select(Region, Provincia, `Organización Política`, Votos) %>%\n",
        "  pivot_wider(names_from = `Organización Política`,\n",
        "              values_from = Votos) %>%\n",
        "  rename(votos_keiko = `FUERZA POPULAR`,\n",
        "         votos_castillo = `PARTIDO POLITICO NACIONAL PERU LIBRE`)\n",
        "\n",
        "# Calculamos el ratio votos_keiko / votos_castillo\n",
        "df_wide$ratio_keiko_castillo <- df_wide$votos_keiko / df_wide$votos_castillo\n",
        "\n",
        "# Mostramos el resultado\n",
        "head(df_wide)"
      ],
