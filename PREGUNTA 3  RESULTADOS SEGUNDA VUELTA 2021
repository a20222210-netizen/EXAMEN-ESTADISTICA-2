        "## 3. Filtrado por candidato\n",
        "Separamos los votos de Keiko Fujimori (Fuerza Popular)\n",
        "y Pedro Castillo (Perú Libre)."
      ],
      "metadata": {
        "id": "9kz47b1eM9R8"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Filtramos solo los candidatos principales, eliminando blancos y nulos\n",
        "df_candidatos <- df[df$`Organización Política` %in%\n",
        "                    c('FUERZA POPULAR',\n",
        "                      'PARTIDO POLITICO NACIONAL PERU LIBRE'), ]\n",
        "\n",
        "# Verificamos cuántas filas quedaron\n",
        "nrow(df_candidatos)"
